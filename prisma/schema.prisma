// Boaz Group Ltd — data model.
//
// The app currently runs on the mock repository in src/lib/data, so no
// database is required to click through the whole product. This schema is
// the target shape: point DATABASE_URL at Neon/Supabase, run
// `npm run db:push`, and swap the repository implementation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  DRIVER
  ADMIN
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
}

enum TruckStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED
}

enum TripStatus {
  PLANNED
  IN_TRANSIT
  AT_BORDER
  DELIVERED
  CANCELLED
}

enum MaintenanceType {
  OIL_CHANGE
  TIRES
  BRAKES
  GENERAL_SERVICE
  REPAIR
  INSPECTION
}

enum ExpenseCategory {
  FUEL
  TOLLS
  BORDER_FEES
  FOOD_LODGING
  PARKING
  REPAIRS
  OTHER
}

enum Currency {
  TZS
  KES
  RWF
  BIF
  UGX
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStopStatus {
  COMPLETED
  CURRENT
  UPCOMING
}

enum TripStopKind {
  ORIGIN
  WAYPOINT
  BORDER
  DESTINATION
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
  ROADSIDE
}

enum InspectionResult {
  PASS
  PASS_WITH_DEFECTS
  FAIL
}

enum MessagePriority {
  NORMAL
  HIGH
}

enum DocumentCategory {
  LICENCE
  IDENTITY
  MEDICAL
  TRAINING
  VEHICLE
}

enum PayrollStatus {
  PAID
  PROCESSING
  SCHEDULED
}

enum LeaveType {
  ANNUAL
  SICK
  COMPASSIONATE
  UNPAID
}

enum EmergencyKind {
  BREAKDOWN
  ACCIDENT
  MEDICAL
  SECURITY
  OTHER
}

enum ShipmentStatus {
  BOOKED
  LOADED
  IN_TRANSIT
  AT_BORDER
  CLEARED
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

// ---------------------------------------------------------------- people

model Driver {
  id           String     @id @default(cuid())
  employeeId   String     @unique // login identifier, e.g. BGL-0142
  passwordHash String
  role         Role       @default(DRIVER)
  fullName     String
  phone        String
  whatsapp     String?
  email        String?
  licenseNumber String    @unique
  licenseClass String?
  licenseExpiry DateTime?
  nationalId   String?
  homeBase     String     @default("Dar es Salaam")
  dutyStatus   DutyStatus @default(OFF_DUTY)
  active       Boolean    @default(true)
  joinedAt     DateTime   @default(now())
  photoUrl     String?

  assignedTruckId String?
  assignedTruck   Truck?  @relation("AssignedDriver", fields: [assignedTruckId], references: [id])

  clockRecords       ClockRecord[]
  maintenanceRecords MaintenanceRecord[]
  expenseReports     ExpenseReport[]
  trips              Trip[]
  inspections        Inspection[]
  messages           DriverMessage[]
  documents          DriverDocument[]
  payrollEntries     PayrollEntry[]
  leaveRequests      LeaveRequest[]
  emergencyAlerts    EmergencyAlert[]
  restSchedule       RestSchedule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

model Admin {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  fullName     String
  email        String   @unique
  title        String?
  createdAt    DateTime @default(now())

  reviewedExpenses ExpenseReport[] @relation("ExpenseReviewer")
}

// ---------------------------------------------------------------- fleet

model Truck {
  id           String      @id @default(cuid())
  plateNumber  String      @unique // e.g. T 123 ABC
  make         String
  model        String
  year         Int
  trailerType  String?
  capacityTons Float?
  odometerKm   Int         @default(0)
  status       TruckStatus @default(ACTIVE)
  nextServiceKm Int?
  insuranceExpiry DateTime?

  // Telemetry surfaced on the driver dashboard.
  fuelLevelPercent  Int   @default(0)
  fuelCapacityLitres Int?
  engineHours       Int   @default(0)

  drivers            Driver[]            @relation("AssignedDriver")
  maintenanceRecords MaintenanceRecord[]
  trips              Trip[]
  inspections        Inspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trailer {
  id               String      @id @default(cuid())
  plateNumber      String      @unique
  type             String
  axles            Int
  capacityTons     Float?
  status           TruckStatus @default(ACTIVE)
  inspectionExpiry DateTime?

  trips       Trip[]
  inspections Inspection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- operations

model Trip {
  id            String     @id @default(cuid())
  reference     String     @unique // e.g. TRP-2026-0184
  origin        String     @default("Dar es Salaam")
  destination   String
  corridorSlug  String // kenya | rwanda | uganda | burundi
  borderPost    String?
  cargoSummary  String?
  status        TripStatus @default(PLANNED)
  departedAt    DateTime?
  expectedAt    DateTime?
  deliveredAt   DateTime?

  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  stops          TripStop[]
  clockRecords   ClockRecord[]
  expenseReports ExpenseReport[]
  shipments      Shipment[]
  emergencyAlerts EmergencyAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, status])
}

model ClockRecord {
  id          String    @id @default(cuid())
  clockInAt   DateTime
  clockOutAt  DateTime?
  clockInNote String?
  clockOutNote String?
  startOdometerKm Int?
  endOdometerKm   Int?
  locationIn  String?
  locationOut String?

  driverId String
  driver   Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId   String?
  trip     Trip?   @relation(fields: [tripId], references: [id])

  createdAt DateTime @default(now())

  @@index([driverId, clockInAt])
}

model MaintenanceRecord {
  id           String          @id @default(cuid())
  performedAt  DateTime
  type         MaintenanceType
  description  String
  costAmount   Float
  costCurrency Currency        @default(TZS)
  odometerKm   Int
  vendor       String?
  receiptUrl   String? // uploaded receipt photo (local /uploads path for now)

  truckId  String
  truck    Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  createdAt DateTime @default(now())

  @@index([truckId, performedAt])
  @@index([driverId, performedAt])
}

model ExpenseReport {
  id          String          @id @default(cuid())
  spentAt     DateTime
  category    ExpenseCategory
  description String
  amount      Float
  currency    Currency

  // Multi-currency: the rate is captured at submission so historical
  // totals never shift when rates move.
  rateToTzs   Float
  amountTzs   Float

  receiptUrl  String?
  status      ApprovalStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?

  driverId   String
  driver     Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId     String?
  trip       Trip?   @relation(fields: [tripId], references: [id])
  reviewedById String?
  reviewedBy   Admin? @relation("ExpenseReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, status])
  @@index([status, spentAt])
}

// ---------------------------------------------------------------- driver portal

model TripStop {
  id          String         @id @default(cuid())
  name        String
  kind        TripStopKind   @default(WAYPOINT)
  status      TripStopStatus @default(UPCOMING)
  sequence    Int
  scheduledAt DateTime?
  arrivedAt   DateTime?
  departedAt  DateTime?
  note        String?

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sequence])
}

model Inspection {
  id          String           @id @default(cuid())
  performedAt DateTime
  type        InspectionType
  result      InspectionResult
  odometerKm  Int
  defects     String[]
  note        String?

  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  truckId   String
  truck     Truck    @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  createdAt DateTime @default(now())

  @@index([driverId, performedAt])
  @@index([truckId, performedAt])
}

model DriverMessage {
  id       String          @id @default(cuid())
  from     String
  fromRole String
  subject  String
  body     String
  sentAt   DateTime        @default(now())
  read     Boolean         @default(false)
  priority MessagePriority @default(NORMAL)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, read])
}

model RestSchedule {
  id              String   @id @default(cuid())
  nextRestAt      DateTime
  requiredMinutes Int      @default(45)
  lastRestEndedAt DateTime?

  driverId String @unique
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model DriverDocument {
  id        String           @id @default(cuid())
  name      String
  category  DocumentCategory
  reference String?
  issuedAt  DateTime?
  expiresAt DateTime?
  fileUrl   String?

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, expiresAt])
}

model PayrollEntry {
  id                String        @id @default(cuid())
  periodLabel       String
  periodEnd         DateTime
  baseAmountTzs     Float
  tripAllowanceTzs  Float
  deductionsTzs     Float         @default(0)
  netTzs            Float
  status            PayrollStatus @default(SCHEDULED)
  paidAt            DateTime?
  tripsCompleted    Int           @default(0)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, periodEnd])
}

model LeaveRequest {
  id         String         @id @default(cuid())
  type       LeaveType
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  status     ApprovalStatus @default(PENDING)
  reviewedAt DateTime?
  reviewNote String?

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([driverId, status])
}

model EmergencyAlert {
  id           String        @id @default(cuid())
  kind         EmergencyKind
  note         String?
  location     String?
  raisedAt     DateTime      @default(now())
  acknowledged Boolean       @default(false)

  driverId String
  driver   Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripId   String?
  trip     Trip?   @relation(fields: [tripId], references: [id])

  @@index([driverId, raisedAt])
}

// ---------------------------------------------------------------- public tracking

model Shipment {
  id            String         @id @default(cuid())
  trackingRef   String         @unique // e.g. BGL-2026-0455
  clientName    String
  origin        String         @default("Dar es Salaam")
  destination   String
  corridorSlug  String
  cargoSummary  String
  weightKg      Float?
  containerNo   String?
  status        ShipmentStatus @default(BOOKED)
  bookedAt      DateTime       @default(now())
  etaAt         DateTime?
  deliveredAt   DateTime?

  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id])

  events ShipmentEvent[]

  @@index([trackingRef])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  occurredAt DateTime
  status     ShipmentStatus
  location   String
  note       String?

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}
