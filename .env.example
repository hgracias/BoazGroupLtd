# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Auth (required) -------------------------------------------------------
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Demo portal accounts (optional, development only) ---------------------
# The mock data layer seeds one driver (BGL-0142) and one admin (ADM-001).
# Set these to pin their passwords locally; leave them unset and a random
# password is generated per server start and printed to the terminal.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
#
# In a production build these accounts are never displayed, so leaving the
# variables unset there means nobody can sign in to the seeded accounts.
# DEMO_DRIVER_PASSWORD=""
# DEMO_ADMIN_PASSWORD=""

# --- Supabase (required for the public quote form to persist) ---------------
# Project settings → API. Both are publishable and safe in the browser.
# Never put a service-role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Cloudflare Turnstile (spam protection, optional but recommended) -------
# Create a widget at https://dash.cloudflare.com → Turnstile.
# The SITE key is public and reaches the browser. The SECRET key must NOT have
# a NEXT_PUBLIC_ prefix and must never be committed.
#
# Behaviour: with no keys set, the honeypot still runs and Turnstile is
# skipped. Once TURNSTILE_SECRET_KEY is set, verification is enforced and a
# missing or invalid token is rejected.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# --- Database (NOT required while the app runs on the mock data layer) ------
# Neon / Supabase connection string. Fill this in only when you switch
# src/lib/data/index.ts from the mock repository to the Prisma repository.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
